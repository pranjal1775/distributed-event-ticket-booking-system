# ============================================================
# Environment Variables — copy to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ticketdb
POSTGRES_USER=ticketuser
POSTGRES_PASSWORD=changeme

# JWT
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Service URLs (used inside containers — Docker service names)
USER_SERVICE_URL=http://user-service:8001
EVENT_SERVICE_URL=http://event-service:8002
BOOKING_SERVICE_URL=http://booking-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Payment simulation mode: success | failure | random
PAYMENT_MODE=random

# Internal service auth token (used by booking-service → notification-service)
INTERNAL_SERVICE_TOKEN=replace-with-internal-token
